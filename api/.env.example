APP_NAME="M-KOPA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mikopofasta_recreation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local demo login created by `php artisan db:seed` (placeholders — change them)
DEMO_ADMIN_PHONE=0700000000
DEMO_ADMIN_PASSWORD=password
DEMO_ADMIN_EMAIL=admin@example.com

# Demo-only role logins created by the seeders (config/demo.php). Local/demo use only — change them
# (or leave the seeders out) on any shared or production environment.
DEMO_HQ_ADMIN_PHONE=0700000008
DEMO_HQ_ADMIN_PASSWORD=password
DEMO_TELLER_PHONE=0700000001
DEMO_TELLER_PASSWORD=password
DEMO_FINANCE_PHONE=0700000002
DEMO_FINANCE_PASSWORD=password
DEMO_ZONE_MANAGER_PHONE=0700000003
DEMO_ZONE_MANAGER_PASSWORD=password
DEMO_BRANCH_MANAGER_PHONE=0700000004
DEMO_BRANCH_MANAGER_PASSWORD=password
DEMO_LOAN_OFFICER_PHONE=0700000005
DEMO_LOAN_OFFICER_PASSWORD=password
DEMO_CREDIT_OFFICER_PHONE=0700000006
DEMO_CREDIT_OFFICER_PASSWORD=password
DEMO_HR_PHONE=0700000007
DEMO_HR_PASSWORD=password

# External integrations. "test" drivers are deterministic and need no credentials
# (OTP 123456, fixture NIDA data, simulated Vodacom disbursement). Set real drivers and keys per environment.
NIDA_DRIVER=test
NIDA_BASE_URL=
NIDA_API_KEY=
FACE_DRIVER=test
FACE_BASE_URL=
FACE_API_KEY=
SMS_DRIVER=log
SMS_SENDER_ID=
SMS_API_KEY=
VODACOM_DRIVER=test
VODACOM_BASE_URL=
VODACOM_API_KEY=
VODACOM_CALLBACK_SECRET=
VODACOM_PORTAL_URL=
VODACOM_TEST_OUTCOME=success
BANK_MANDATE_DRIVER=test
BANK_MANDATE_BASE_URL=
BANK_MANDATE_API_KEY=
PAYMENTS_DRIVER=test
PAYMENTS_WEBHOOK_SECRET=
PAYMENTS_COMPANY_ID=

# Password a staff account is reset to from HRM > All Active Staff > Reset password (required for that action; never commit a value).
DEFAULT_STAFF_PASSWORD=
